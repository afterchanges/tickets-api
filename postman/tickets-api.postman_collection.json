{
  "info": {
    "_postman_id": "8a492b23-6c79-44b7-902c-1ab0f92ea1b8",
    "name": "tickets-api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-generate a unique user email once per run (prevents email_taken).",
          "const autoGen = (pm.environment.get('autoGenerateEmail') || 'true').toLowerCase() === 'true';",
          "const alreadyGenerated = pm.environment.get('generatedUserEmail');",
          "const currentEmail = pm.environment.get('userEmail');",
          "if (autoGen && !alreadyGenerated) {",
          "  const ts = Date.now();",
          "  const email = `user+${ts}@example.com`;",
          "  pm.environment.set('generatedUserEmail', email);",
          "  pm.environment.set('userEmail', email);",
          "} else if (alreadyGenerated && currentEmail !== alreadyGenerated) {",
          "  // Keep register/login consistent across requests in the same run.",
          "  pm.environment.set('userEmail', alreadyGenerated);",
          "}",
          "",
          "// Add a request id to every request (server echoes it back).",
          "pm.request.headers.upsert({ key: 'X-Request-Id', value: pm.variables.replaceIn('{{$guid}}') });",
          "",
          "// Default JSON accept header.",
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Capture request id from the response headers for debugging.",
          "const rid = pm.response.headers.get('X-Request-Id');",
          "if (rid) pm.environment.set('lastRequestId', rid);"
        ]
      }
    }
  ],
